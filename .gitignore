# ---- 빌드 결과: GitHub Actions가 `npm run build`로 다시 만든다 ----
dist/
node_modules/

# ---- 비밀 값: 어떤 이름으로든 올리지 않는다 (OpenRouter 키, Supabase secret/service_role 키 등) ----
.env
.env.*
*.pem
*.key
supabase/.env
supabase/.temp/
supabase/.branches/

# ---- 개발 도구가 만드는 상태와 임시 파일 ----
.omc/
.claude/
.playwright-mcp/
*.log
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# 점검 중 찍은 스크린샷, 실행 결과 (필요한 이미지는 public/ 이나 docs/ 에 둔다)
/*.png
/*.jpg
tests/manual/*.out.*
tests/manual/output/

# ---- 저장소에 올리지 않는 문서와 파일 ----
# 논문 원본 PDF: 제3자 저작물이고, 이 앱은 PDF를 저장하지 않는다는 원칙과도 맞지 않는다
*.pdf
!tests/fixtures/pdf/*.pdf
# PRD를 내보낸 사본 (원본은 PRD.md)
docs/*.docx
# 개인 기획 메모
docs/*프롬프트.txt

# 4.5MB 원본 스플래시 이미지: 배포에는 같은 그림의 JPG(public/papernote_splash.jpg)를 쓴다
public/papernote_splash.png
